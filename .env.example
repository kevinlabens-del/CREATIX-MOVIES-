# Variables de collecte côté serveur uniquement, jamais préfixées par VITE_.
# Fournir ces valeurs à l'environnement ; les scripts ne chargent pas .env automatiquement.
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_PAGES=20
DAILYMOTION_PAGES=10
# RECHECK_ALL=1 force la revérification de vidéos vérifiées depuis moins de 24 h.
# VITE_BASE_PATH=./ garde un build portable dans un sous-dossier.
